---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SlideDeckViewer from "../../components/SlideDeckViewer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = post.data.pubDate.toISOString().slice(0, 10);
---

<BaseLayout title={`${post.data.title} — mhcfa`} description={post.data.description}>
  <article>
    <header class="article-header">
      <div class="article-meta">
        <a href="/" style="text-decoration: none; color: var(--accent);">← All Writing</a>
        <span>·</span>
        <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        {post.data.readingTime && (
          <>
            <span>·</span>
            <span>{post.data.readingTime}</span>
          </>
        )}
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      {post.data.subtitle && <p class="article-subtitle">{post.data.subtitle}</p>}
      <div class="tag-list">
        {post.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>

    {post.data.slideDeck && (
      <SlideDeckViewer
        title={post.data.slideDeck.title}
        subtitle={post.data.slideDeck.subtitle}
        pdfUrl={post.data.slideDeck.pdfUrl}
        xlsxUrl={post.data.slideDeck.xlsxUrl}
        xlsxLabel={post.data.slideDeck.xlsxLabel}
        slideCount={post.data.slideDeck.slideCount}
        slidePrefix={post.data.slideDeck.slidePrefix}
      />
    )}

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
